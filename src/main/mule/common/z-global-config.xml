<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
	xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd 
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
    
	http://www.mulesoft.org/schema/mule/core
	http://www.mulesoft.org/schema/mule/core/current/mule.xsd
	
	http://www.mulesoft.org/schema/mule/http
	http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
	
	http://www.mulesoft.org/schema/mule/ee/core
	http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
	
	http://www.mulesoft.org/schema/mule/sftp
	http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd">

	<global-property
		name="mule.env"
		value="local" />

	<global-property
		name="mule.key"
		value="mule123" />

	<configuration-properties
    	doc:name="common-configuration-properties"
    	file="properties.common/common.yaml" />

	<configuration-properties
    	doc:name="environment-specific-common-configuration"
    	file="properties/config-${mule.env}.yaml" />

	<http:listener-config
		name="dtworld-order-papi-http-listener-configuration"
		doc:name="dtworld-order-papi-httpListenerConfig">
		<http:listener-connection
			host="${http.listener.host}"
			port="${http.listener.port}" />
	</http:listener-config>
	
	<http:request-config
		name="db-sys-api-http-request-configuration"
		doc:name="db-sys-api-http-request-configuration">
		<http:request-connection
			protocol="HTTP"
			host="${db.sys.api.host}"
			port="${db.sys.api.port}" />
	</http:request-config>

	<sftp:config
		name="sftp-configuration"
		doc:name="SFTP Config"
		doc:id="857dfed2-8169-462e-84e5-fdbb9a12ed72">
		<sftp:connection
			host="${sftp.host}"
			port="${sftp.port}"
			username="${sftp.username}"
			password="${sftp.password}" />
	</sftp:config>

</mule>